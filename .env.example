# Server-owned model credentials. Never commit .env or put keys in the GUI.
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001
CLAUDE_BASE_URL=https://api.anthropic.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_VISION=true

HOST=127.0.0.1
PORT=8787
DATA_DIR=./data
SKILLS_DIR=./skills
TIMEZONE=Asia/Kolkata
# Required before binding to 0.0.0.0 or another non-loopback interface.
GUI_PASSWORD=
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
COOKIE_SECURE=false
# Internal URL used by local GUI demos, reachable from the server's browser.
INTERNAL_URL=http://127.0.0.1:8787
BROWSER_MODE=managed
BROWSER_HEADLESS=true
# Cookies/localStorage are persisted in DATA_DIR/browser-profile.
CDP_URL=
BROWSER_ALLOWED_HOSTS=localhost,127.0.0.1,::1
DESKTOP_ENABLED=false
MAX_STEPS=100
MAX_SECONDS=300
# Learned skills are local overlays under DATA_DIR/skills; bundled skills stay unchanged.
SKILL_WRITES_ENABLED=true
# A configured freeze manifest disables skill learning and is checked before every run.
FREEZE_MANIFEST=
# Optional server event sources; copy config.triggers.example.json and configure env references first.
TRIGGERS_FILE=
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
